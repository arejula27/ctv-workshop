# Copy to infra/.env and change the secrets.
RPC_USER=workshop
RPC_PASS=change-me-rpc
ADMIN_TOKEN=change-me-admin

# Public URL participants open (used by the explorer to reach the API).
PUBLIC_URL=http://localhost:8080
# ":80" for LAN; a domain name on a VPS (then HTTP_PORT=80, HTTPS_PORT=443).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
EXPLORER_PORT=5000
# bitcoind RPC on 127.0.0.1, for debugging (18443 is often taken by other regtests)
RPC_DEBUG_PORT=18543

# Chain clock
MINER_INTERVAL_S=30
MINER_PAUSED=false
FAUCET_AMOUNT_SAT=1000000
FAUCET_COOLDOWN_S=60
